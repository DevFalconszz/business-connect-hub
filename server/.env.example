# Business Connect Hub - Server Environment Variables

# Porta do servidor (padrão: 3001)
PORT=3001

# Google Maps API Key (Free Tier: $200/mês)
# Como obter:
# 1. Acesse https://console.cloud.google.com/
# 2. Crie um projeto ou selecione um existente
# 3. Ative a "Places API" em APIs e Serviços
# 4. Crie uma chave de API em Credenciais
GOOGLE_MAPS_API_KEY=

# Meta Ad Library Access Token (Gratuito)
# Como obter:
# 1. Acesse https://developers.facebook.com/
# 2. Crie um app (tipo: Business)
# 3. Vá em Configurações > Básico
# 4. Gere um Token de Acesso de curta duração
# 5. Troque por token de longa duração via API:
#    GET https://graph.facebook.com/v19.0/oauth/access_token?
#        grant_type=fb_exchange_token&
#        client_id=YOUR_APP_ID&
#        client_secret=YOUR_APP_SECRET&
#        fb_exchange_token=YOUR_SHORT_LIVED_TOKEN
META_ACCESS_TOKEN=

# Firecrawl API Key (Obrigatório se não tiver Google Maps)
# Usado para buscar estabelecimentos quando Google Maps não está disponível
# Free tier: 500 créditos/mês
# Obtenha em: https://firecrawl.dev/
FIRECRAWL_API_KEY=
